{
  "name": "bua-aidm-backend-api",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Academic Advisor backend API (AIDM, Badr University in Assiut)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate -m ../db/migrations -d MIGRATION_DATABASE_URL",
    "migrate:up": "node-pg-migrate -m ../db/migrations -d MIGRATION_DATABASE_URL up",
    "migrate:down": "node-pg-migrate -m ../db/migrations -d MIGRATION_DATABASE_URL down",
    "seed": "node dist/jobs/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "node-pg-migrate": "7.9.0",
    "nodemailer": "6.9.16",
    "pdfkit": "0.16.0",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "eslint": "9.18.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1"
  }
}
