# ---------------------------------------------------------------------------
# Smart Academic Advisor - backend API environment
# Copy to .env and replace every secret before running outside local dev.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Runtime connection: least-privilege application role (created by migration).
DATABASE_URL=postgres://smart_advisor_app:dev_app_password_change_me@localhost:55432/smart_advisor
DB_POOL_MAX=10

# Migration connection: owner/superuser role. Used only by `npm run migrate`.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:55432/smart_advisor
DB_APP_PASSWORD=dev_app_password_change_me

# JWT / sessions (>= 32 chars each; rotate in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_PEPPER=dev-refresh-pepper-change-me-0123456789abcdef
JWT_ISSUER=bua-aidm-advisor
JWT_AUDIENCE=bua-aidm-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30

# Rule engine (internal network only; never expose publicly)
ENGINE_URL=http://localhost:8001
ENGINE_SERVICE_TOKEN=dev-engine-token-change-me
ENGINE_HMAC_SECRET=dev-engine-hmac-secret-change-me-0123456789
ENGINE_TIMEOUT_MS=8000

# HTTP / security
ALLOWED_EMAIL_DOMAIN=aidm.bua.edu.eg
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
CSRF_COOKIE_NAME=csrf_token
REFRESH_COOKIE_NAME=refresh_token
TRUST_PROXY=loopback
BODY_LIMIT=100kb
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=20
IMPORT_RATE_LIMIT_MAX=5
EXPORT_RATE_LIMIT_MAX=10

# Uploads / exports
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5000000
QR_SIGNING_SECRET=dev-qr-secret-change-me-0123456789

# Email (MailHog in docker compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@aidm.bua.edu.eg
APP_BASE_URL=http://localhost:5173

# Seed data
DEMO_PASSWORD=ChangeMe!2026
REGULATION_DATA_DIR=../regulation-data
