  "rules": [
    {
      "rule_code": "R-ADM-05.2",
      "article": "5",
      "clause": 2,
      "page": 5,
      "title_ar": "التحويل",
      "summary_ar": "لا يزيد ما يمكن تحويله عن 40% من مقررات البرنامج وتدرج التقديرات ضمن التراكمي."
    },
    {
      "rule_code": "R-ACA-06.3",
      "article": "6",
      "clause": 3,
      "page": 6,
      "title_ar": "الفصل الصيفي",
      "summary_ar": "اختياري ومكثف 8 أسابيع بأقصى 9 ساعات، ويسمح لمن لم يستوف الحد الأقصى أو لإعادة المقررات أو رفع CGPA أو الانتقال لمستوى أعلى أو استكمال التخرج."
    },
    {
      "rule_code": "R-GRAD-DURATION",
      "article": "6",
      "clause": "4,6",
      "page": 6,
      "title_ar": "المدة",
      "summary_ar": "الحد الأقصى 16 فصلاً نظامياً ولا تحتسب فصول إيقاف القيد المعتمدة، والتخرج بـ 136 ساعة في 6 فصول نظامية على الأقل."
    },
    {
      "rule_code": "R-LOAD-MIN",
      "article": "8",
      "clause": 1,
      "page": 8,
      "title_ar": "الحد الأدنى",
      "summary_ar": "9 ساعات ويجوز التجاوز إذا كان المتبقي للتخرج أقل من 9."
    },
    {
      "rule_code": "R-LOAD-MAX",
      "article": "8",
      "clause": 1,
      "page": 8,
      "title_ar": "الحد الأقصى",
      "summary_ar": "حسب CGPA بداية الفصل: >=3.00 → 21، 2.00-3.00 → 18، 1.00-2.00 → 15، <1.00 → 12، والمستجد 18."
    },
    {
      "rule_code": "R-REG-09.5",
      "article": "9",
      "clause": 5,
      "page": 8,
      "title_ar": "المتطلب السابق",
      "summary_ar": "لا يسجل مقرر له متطلب إلا بعد دراسته والنجاح فيه."
    },
    {
      "rule_code": "R-REG-09.8",
      "article": "9",
      "clause": 8,
      "page": 9,
      "title_ar": "التسجيل المتزامن",
      "summary_ar": "استثناء مع المتطلب السابق إذا كان يؤثر على التخرج، بموافقة المرشد، ومجلس الكلية في حالة الرسوب في المتطلب → REVIEW_REQUIRED."
    },
    {
      "rule_code": "R-REG-09.6-7",
      "article": "9",
      "clause": "6,7",
      "page": "8-9",
      "title_ar": "الإعادة",
      "summary_ar": "يحق إعادة المقرر الراسب، ويحق إعادة مقرر ناجح لتحسين CGPA."
    },
    {
      "rule_code": "R-DROP-10",
      "article": "10",
      "clause": "1-6",
      "page": 9,
      "title_ar": "الحذف والإضافة والانسحاب",
      "summary_ar": "حذف وإضافة حتى نهاية الأسبوع 2، انسحاب بتقدير W حتى نهاية الأسبوع 10 بشرط عدم تجاوز نسبة الغياب وعدم الإخلال بالعبء، وبعده F. لا ينطبق على الصيفي."
    },
    {
      "rule_code": "R-ATT-11",
      "article": "11",
      "clause": "1-3",
      "page": 9,
      "title_ar": "المواظبة",
      "summary_ar": "حضور لا يقل عن 75%، وبعد إنذارين متعاقبين يحرم ويحصل على F، وبعذر مقبول يسجل W."
    },
    {
      "rule_code": "R-LVL-12",
      "article": "12",
      "clause": 1,
      "page": 10,
      "title_ar": "المستويات",
      "summary_ar": "حسب الساعات المجتازة: 0-<26، 26-<62، 62-<96، 96-<136."
    },
    {
      "rule_code": "R-TRAIN-13",
      "article": "13",
      "clause": "1-4",
      "page": 10,
      "title_ar": "التدريب الميداني",
      "summary_ar": "بدون ساعات ولا يحسب في GPA ومتطلب تخرج، بعد 68 ساعة مجتازة، ويجوز في الصيف."
    },
    {
      "rule_code": "R-PROJECT-13.7",
      "article": "13",
      "clause": 7,
      "page": 10,
      "title_ar": "مشروع التخرج",
      "summary_ar": "للمستوى الرابع بعد اجتياز 70% من الساعات (96)، ويسجل في الفصول الرئيسية."
    },
    {
      "rule_code": "R-SUSP-14",
      "article": "14",
      "clause": "1-4",
      "page": 11,
      "title_ar": "إيقاف القيد",
      "summary_ar": "طلب قبل شهر من الامتحانات النهائية، ولا يتجاوز 4 فصول متتالية أو 6 متفرقة."
    },
    {
      "rule_code": "R-EXAM-15",
      "article": "15",
      "clause": "8-10",
      "page": 12,
      "title_ar": "التقييم",
      "summary_ar": "أعمال 25 + نصفي 25 + نهائي 50، ويرسب لائحياً بأقل من 30% من النهائي أو أقل من 50% من المجموع."
    },
    {
      "rule_code": "R-GRADE-16.1",
      "article": "16",
      "clause": 1,
      "page": "12-13",
      "title_ar": "جدول التقديرات",
      "summary_ar": "من A+ (96%+) إلى F (<50%) بنقاط 4.00-0.00 (grade_scale)."
    },
    {
      "rule_code": "R-GPA-16.2",
      "article": "16",
      "clause": 2,
      "page": "13-14",
      "title_ar": "المتوسطات",
      "summary_ar": "SGPA وCGPA بالمعادلة، ويقربان إلى رقمين عشريين."
    },
    {
      "rule_code": "R-HONORS-16.4",
      "article": "16",
      "clause": 4,
      "page": 14,
      "title_ar": "مرتبة الشرف",
      "summary_ar": "CGPA>=3.00 دون رسوب أو حرمان وخلال 8 فصول."
    },
    {
      "rule_code": "R-PROB-16.5",
      "article": "16",
      "clause": 5,
      "page": 14,
      "title_ar": "الإنذار الأكاديمي",
      "summary_ar": "CGPA أقل من 2.00 في أي فصل غير الأول → إنذار وملاحظة أكاديمية وتقييد العبء."
    },
    {
      "rule_code": "R-REPEAT-16.6",
      "article": "16",
      "clause": 6,
      "page": 14,
      "title_ar": "تكرار الرسوب",
      "summary_ar": "الرسوب يحتسب مرة واحدة في CGPA ويسجل عدد المحاولات وآخر درجة نجاح."
    },
    {
      "rule_code": "R-INCOMPLETE-16.8",
      "article": "16",
      "clause": "8-9",
      "page": "14-15",
      "title_ar": "غير مكتمل",
      "summary_ar": "عذر قهري خلال يومين من النهائي وبحد أدنى 60% من الأعمال ودون حرمان → I، وإلا → W."
    },
    {
      "rule_code": "R-REPEAT-CAP-16.11",
      "article": "16",
      "clause": "11,14,15",
      "page": "15-16",
      "title_ar": "سقف درجة الإعادة",
      "summary_ar": "درجة الإعادة بحد أقصى 83% (B)، وتحسين المقررات الناجحة بحد أقصى 3 مقررات عند CGPA>=2.00."
    },
    {
      "rule_code": "R-GRAD-17",
      "article": "17",
      "clause": "1-5",
      "page": 16,
      "title_ar": "متطلبات التخرج",
      "summary_ar": "136 ساعة بـ CGPA>=2.00، نجاح المقررات بدون ساعات، 6 فصول نظامية على الأقل، التدريب الميداني."
    },
    {
      "rule_code": "R-GRAD-18",
      "article": "18",
      "clause": "1-3",
      "page": 16,
      "title_ar": "التخرج",
      "summary_ar": "التخرج بعد نتيجة الفصل الثاني (يونيو) أو دور سبتمبر بعد الصيفي."
    },
    {
      "rule_code": "R-DISMISS-21",
      "article": "21",
      "clause": "1-4",
      "page": 18,
      "title_ar": "الفصل من الكلية",
      "summary_ar": "4 إنذارات متتالية أو 6 متفرقة أو تجاوز المدة، وفرصة أخيرة لمن اجتاز 80% من الساعات (109)."
    }
